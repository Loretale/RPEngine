$C = "../Common.ui";

Group {
  LayoutMode: Center;

  Group #CreatePanel {
    Anchor: (Width: 500, Height: 360);
    LayoutMode: Top;
    Padding: (Full: 20);
    Background: #141c26;

    Label {
      Text: "Create Character";
      Anchor: (Height: 40);
      Style: (
        FontSize: 26,
        RenderBold: true,
        HorizontalAlignment: Center,
        TextColor: #ffffff
      );
    }

    $C.@ContentSeparator {
      Anchor: (Height: 1);
    }

    Label {
      Text: "Character Name";
      Anchor: (Height: 24);
      Style: (
        FontSize: 14,
        TextColor: #9fb3c8
      );
    }

    TextField #NameInput {
      Anchor: (Height: 40);
      Background: $C.@InputBoxBackground;
      Style: $C.@DefaultInputFieldStyle;
      Padding: (Left: 8, Right: 8);
    }

    Group {
      Anchor: (Height: 24);
    }

    Group {
      LayoutMode: Center;
      Anchor: (Height: 44);

      $C.@TextButton #CreateBtn {
        @Text = "Create";
        Anchor: (Width: 160, Height: 44);
      }

      Group { Anchor: (Width: 12); }

      $C.@CancelTextButton #CancelBtn {
        @Text = "Cancel";
        Anchor: (Width: 160, Height: 44);
      }
    }
  }
}
